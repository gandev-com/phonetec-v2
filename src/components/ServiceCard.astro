---
interface Props {
  title: string;
  description: string;
  icon: string;
}

const { title, description, icon } = Astro.props;
---

<article class="group rounded-3xl border border-white/10 bg-white/5 p-6 shadow-md shadow-black/30 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-phonetec/40" data-reveal>
  <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-phonetec/15 transition-transform duration-300 group-hover:scale-110 group-hover:rotate-3">
    <img src={icon} alt={title} loading="lazy" decoding="async" class="h-10 w-10 object-contain" />
  </div>
  <h3 class="mt-5 text-xl font-bold text-white">{title}</h3>
  <p class="mt-3 text-sm leading-7 text-slate-400">{description}</p>
</article>